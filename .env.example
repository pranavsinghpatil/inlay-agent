# Required to forward requests beyond the no-op proxy.
INLAY_UPSTREAM_BASE_URL=https://your-openai-compatible-provider.example/v1
# Pi-only Step 3 configuration is supplied in the shell; never place API keys here.
# INLAY_PROVIDER_API_KEY=...
# INLAY_PROVIDER_MODEL=...
# INLAY_PROVIDER_REASONING=true|false
# INLAY_PROVIDER_INPUTS=text[,image]
# INLAY_PROVIDER_CONTEXT_WINDOW=...
# INLAY_PROVIDER_MAX_TOKENS=...
# INLAY_PROVIDER_COST_INPUT=... # USD / million tokens
# INLAY_PROVIDER_COST_OUTPUT=... # USD / million tokens
# INLAY_PROVIDER_COST_CACHE_READ=... # USD / million tokens
# INLAY_PROVIDER_COST_CACHE_WRITE=... # USD / million tokens

# Loopback-only listener. Do not bind this proxy publicly.
INLAY_HOST=127.0.0.1
INLAY_PORT=8787
INLAY_MAX_BODY_BYTES=10485760
INLAY_UPSTREAM_TIMEOUT_MS=120000

